<assembly xmlns="http://apache.org"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://apache.org
                              http://apache.org">
    <!-- Unique ID appended to the final zip file name -->
    <id>distribution</id>
    <formats>
        <format>zip</format>
    </formats>
    <includeBaseDirectory>false</includeBaseDirectory>

    <fileSets>
        <!-- Example: Including project build artifacts -->
        <fileSet>
            <directory>${project.build.directory}</directory>
            <outputDirectory>/</outputDirectory>
            <includes>
                <include>*.jar</include>
            </includes>
        </fileSet>
        <!-- Example: Including external configuration folders -->
        <fileSet>
            <directory>${project.basedir}/config</directory>
            <outputDirectory>/config</outputDirectory>
        </fileSet>
    </fileSets>
</assembly>
